  "hints": [
    {
      "name": "server.forward-headers-strategy",
      "values": [
        {
          "value": "none",
          "description": "The headers are ignored, the default: the request is what reached the server."
        },
        {
          "value": "native",
          "description": "The headers of trusted proxies are applied (Spring Boot: the container's own support, Tomcat's `RemoteIpValve`)."
        },
        {
          "value": "framework",
          "description": "The same here (Spring Boot: Spring's `ForwardedHeaderFilter`)."
        }
      ]
    },
    {
      "name": "server.session.cookie.same-site",
      "values": [
        {
          "value": "lax",
          "description": "`SameSite=Lax`. The default."
        },
        {
          "value": "strict",
          "description": "`SameSite=Strict`."
        },
        {
          "value": "none",
          "description": "`SameSite=None` (browsers want `Secure` with it)."
        },
        {
          "value": "unset",
          "description": "No `SameSite` attribute."
        }
      ]
    },
    {
      "name": "server.shutdown",
      "values": [
        {
          "value": "graceful",
          "description": "Stop accepting connections and let running requests finish, for up to `spring.lifecycle.timeout-per-shutdown-phase` (30 seconds by default); then close what is left. The default."
        },
        {
          "value": "immediate",
          "description": "Close every connection right away, cutting running requests."
        }
      ]
    },
    {
      "name": "server.ssl.client-auth",
      "values": [
        {
          "value": "none",
          "description": "No client certificate is asked for. The default."
        },
        {
          "value": "want",
          "description": "A client certificate is asked for; a client without one is served anyway."
        },
        {
          "value": "need",
          "description": "A client certificate is required; a request without one gets a 403."
        }
      ]
    },

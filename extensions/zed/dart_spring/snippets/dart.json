  "Widget test": {
    "prefix": "spwidgettest",
    "description": "Widget test with the application's beans (springBootTest + SpringScope)",
    "body": [
      "import 'package:flutter_test/flutter_test.dart';",
      "import 'package:spring_boot_starter_flutter/spring_boot_starter_flutter.dart';",
      "import 'package:spring_boot_starter_test/spring_boot_starter_test.dart';",
      "",
      "import '${1:package:app/main}.spring.dart';",
      "",
      "void main() {",
      "  final app = springBootTest(springApplication);",
      "",
      "  setUp(app.markDirty); // fresh beans for every test",
      "",
      "  testWidgets('${2:works}', (tester) async {",
      "    await tester.pumpWidget(",
      "      SpringScope(applicationContext: app.context, child: const ${3:App}()),",
      "    );",
      "    $0",
      "  });",
      "}"
    ]
  },
  "springBootTest": {
    "prefix": "sptest",
    "description": "Test file starting the whole application (spring_boot_starter_test)",
    "body": [
      "import 'package:spring_boot_starter_test/spring_boot_starter_test.dart';",

    "body": [
      "@BuildContextAccess(${1:name: '${2:name}'})$0"
    ]
  },
  "@NotifyListeners": {
    "prefix": "spnotify",
    "description": "A ChangeNotifier bean that calls notifyListeners() after each method through its proxy",
    "body": [
      "@Component()",
      "@NotifyListeners()",
      "class ${1:Basket} extends ChangeNotifier {",
      "  $0",
      "}"
    ]
  },
  "@Value asset": {

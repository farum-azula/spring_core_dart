    ]
  },
  "Flutter app": {
    "prefix": "spflutter",
    "description": "Flutter main with @SpringBootApplication; SpringApplicationWidget(home:) builds the app widget from spring.flutter.app.* (spring_boot_starter_flutter)",
    "body": [
      "import 'package:flutter/widgets.dart';",
      "import 'package:spring_boot_starter_flutter/spring_boot_starter_flutter.dart';",
      "",
      "import '${1:main}.spring.dart';",
      "",
      "@SpringBootApplication()",
      "void main() => runApp(",
      "  SpringApplicationWidget(",
      "    application: () => springApplication,",
      "    home: const ${2:HomePage}(),",
      "  ),",
      ");$0"
    ]
  },
  "SpringStatelessWidget": {
    "prefix": "spstateless",
    "description": "A stateless widget that gets beans as `beans`, rebuilt when a Listenable one notifies",
    "body": [
      "class ${1:Name} extends SpringStatelessWidget<(${2:Bean},)> {",
      "  const ${1:Name}({super.key});",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    final (${3:bean},) = beans;",
      "    return $0;",
      "  }",
      "}"
    ]
  },
  "SpringStatefulWidget": {
    "prefix": "spstateful",
    "description": "A stateful widget whose SpringState gets beans as `beans` (from initState on)",
    "body": [
      "class ${1:Name} extends SpringStatefulWidget<(${2:Bean},)> {",
      "  const ${1:Name}({super.key});",
      "",
      "  @override",
      "  State<${1:Name}> createState() => _${1:Name}State();",
      "}",
      "",
      "class _${1:Name}State extends SpringState<${1:Name}, (${2:Bean},)> {",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    final (${3:bean},) = beans;",
      "    return $0;",
      "  }",
      "}"
    ]
  },
  "@ChangeNotifierComponent": {
    "prefix": "spnotifier",
    "description": "State in a bean: its proxy notifies listeners after every method; context.<name> getter via @BuildContextAccess",
    "body": [

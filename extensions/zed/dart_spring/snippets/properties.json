{
  "Flutter app widget": {
    "prefix": "spapp",
    "description": "spring.flutter.app: the app widget SpringApplicationWidget(home:) builds",
    "body": [
      "# widgets (default) | material | cupertino",
      "spring.flutter.app.type=${1:material}",
      "spring.flutter.app.title=${2:My app}",
      "spring.flutter.app.debug-banner=${3:true}",
      "# default: the languages of messages_*.properties",
      "#spring.flutter.app.locales=en,ja",
      "$0"
    ]
  },
  "Theme": {
    "prefix": "sptheme",
    "description": "spring.flutter.theme: the shared part, the active theme and the dark one",
    "body": [
      "# system | light | dark | a theme of themes",
      "spring.flutter.theme.active=${1:system}",
      "spring.flutter.theme.seed-color=${2:deepPurple}",
      "spring.flutter.theme.typography.font-family=${3:Roboto}",
      "spring.flutter.theme.typography.display.weight=bold",
      "spring.flutter.theme.shape.medium=${4:16}",
      "spring.flutter.theme.components.app-bar.center-title=true",
      "spring.flutter.theme.components.card.shape=large",
      "spring.flutter.theme.components.input.style=outline",
      "spring.flutter.theme.themes.dark.seed-color=${5:deepPurple.shade200}",
      "$0"
    ]
  },
  "New theme": {
    "prefix": "spthemenew",
    "description": "A custom theme: themes.<name>.*",
    "body": [
      "spring.flutter.theme.themes.${1:ocean}.extends=${2:light}",
      "spring.flutter.theme.themes.${1:ocean}.brightness=${3:light}",
      "spring.flutter.theme.themes.${1:ocean}.seed-color=${4:teal}",
      "$0"
    ]
  },
  "Theme colors": {
    "prefix": "spcolors",
    "description": "Color roles over the seed's palette",
    "body": [
      "spring.flutter.theme.colors.primary=${1:#6750A4}",
      "spring.flutter.theme.colors.secondary=${2:#625B71}",
      "spring.flutter.theme.colors.error=${3:#B3261E}",
      "spring.flutter.theme.colors.surface=${4:#FEF7FF}",
      "$0"
    ]
  },
  "Theme color object": {
    "prefix": "spcolorobject",
    "description": "A color with alpha or mix: the object form (the one-line forms are gone)",
    "body": [
      "spring.flutter.theme.colors.${1:primary-container}.color=\\$colors.${2:primary}",
      "spring.flutter.theme.colors.${1:primary-container}.alpha=${3:12%}",
      "spring.flutter.theme.colors.${4:secondary-container}.color=\\$colors.${5:secondary}",
      "spring.flutter.theme.colors.${4:secondary-container}.mix.with=${6:white}",
      "spring.flutter.theme.colors.${4:secondary-container}.mix.amount=${7:14%}",
      "$0"
    ]
  },
  "Theme typography": {
    "prefix": "sptypography",
    "description": "Fonts per text role (font files: any asset directory, found by family)",
    "body": [
      "spring.flutter.theme.typography.font-family=${1:Roboto}",
      "spring.flutter.theme.typography.font-family-fallback=${2:Noto Sans JP}",
      "spring.flutter.theme.typography.display.font-family=${3:Roboto Condensed}",
      "spring.flutter.theme.typography.display.weight=bold",
      "spring.flutter.theme.typography.title-large.weight=500",
      "spring.flutter.theme.typography.code.font-family=${4:monospace}",
      "$0"
    ]
  },
  "Theme shapes": {
    "prefix": "spshape",
    "description": "The Material 3 shape scale (corner radii)",
    "body": [
      "spring.flutter.theme.shape.small=${1:8}",
      "spring.flutter.theme.shape.medium=${2:12}",
      "spring.flutter.theme.shape.large=${3:16}",
      "spring.flutter.theme.shape.extra-large=${4:28}",
      "$0"
    ]
  },
  "Theme components": {
    "prefix": "spcomponents",
    "description": "Material components from the theme's tokens",
    "body": [
      "spring.flutter.theme.components.app-bar.center-title=${1:true}",
      "spring.flutter.theme.components.button.shape=${2:full}",
      "spring.flutter.theme.components.card.shape=${3:large}",
      "spring.flutter.theme.components.card.color=\\$colors.surface-container-low",
      "spring.flutter.theme.components.input.style=${4:outline}",
      "spring.flutter.theme.components.snack-bar.behavior=floating",
      "$0"
    ]
  },
  "Theme tokens": {
    "prefix": "sptokens",
    "description": "The app's own tokens: SpringTheme.of(context).tokenColor / tokenNumber",
    "body": [
      "spring.flutter.theme.tokens.${1:brand}.accent=${2:#FF6B00}",
      "spring.flutter.theme.tokens.${1:brand}.hero-height=${3:240}",
      "$0"
    ]
  },
  "Fonts": {
    "prefix": "spfonts",
    "description": "Font files among the assets: switch off, leave some out",
    "body": [
      "spring.flutter.fonts.auto-load=${1:true}",
      "spring.flutter.fonts.exclude=${2:assets/pdf/**}",
      "$0"
    ]
  },
  "Theme loaders": {
    "prefix": "sploader",
    "description": "spring.flutter.theme.loaders: a built-in loader (spinner, dots, pulse, bar, skeleton)",
    "body": [
      "spring.flutter.theme.loaders.${1:dots}.kind=${2:dots}",
      "spring.flutter.theme.loaders.${1:dots}.color=\\$colors.primary",
      "spring.flutter.theme.loaders.${1:dots}.size=${3:10}",
      "spring.flutter.theme.loaders.${1:dots}.animation.duration=${4:900ms}",
      "spring.flutter.theme.loaders.${1:dots}.animation.curve=ease-in-out",
      "spring.flutter.theme.loaders.${1:dots}.animation.repeat=loop",
      "$0"
    ]
  },
  "Theme loader of the app's own kind": {
    "prefix": "sploaderkind",
    "description": "A loader of a @ThemeLoaderKind class, with phases and the web page loader file",
    "body": [
      "spring.flutter.theme.loaders.${1:neon-doors}.kind=${2:doors}",
      "spring.flutter.theme.loaders.${1:neon-doors}.phases.close.duration=500ms",
      "spring.flutter.theme.loaders.${1:neon-doors}.phases.close.curve=ease-in",
      "spring.flutter.theme.loaders.${1:neon-doors}.phases.fill.progress=true",
      "spring.flutter.theme.loaders.${1:neon-doors}.phases.open.duration=450ms",
      "spring.flutter.theme.loaders.${1:neon-doors}.phases.open.curve=emphasized",
      "spring.flutter.theme.loaders.${1:neon-doors}.${3:door}.color=${4:#0B0D14}",
      "spring.flutter.theme.loaders.${1:neon-doors}.web=${5:web/loaders/neon-doors.html}",
      "$0"
    ]
  },
  "Theme splash": {
    "prefix": "spsplash",
    "description": "spring.flutter.theme.splash: the splash screen and the web page loader",
    "body": [
      "spring.flutter.theme.loaders.${5:dots}.kind=dots",
      "spring.flutter.theme.loaders.${5:dots}.color=\\$colors.primary",
      "spring.flutter.theme.splash.background.color=\\$colors.${1:surface-container-lowest}",
      "spring.flutter.theme.splash.logo.source=${2:assets/images/logo.png}",
      "spring.flutter.theme.splash.logo.size=${3:96}",
      "spring.flutter.theme.splash.title=${4:My app}",
      "spring.flutter.theme.splash.loader=${5:dots}",
      "spring.flutter.theme.splash.min-duration=${6:1.2s}",
      "spring.flutter.theme.splash.exit.transition=400ms ease-out",
      "$0"
    ]
  }
}

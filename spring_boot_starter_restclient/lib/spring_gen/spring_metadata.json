  "properties": [
    {
      "name": "spring.http.clients.allowed-addresses",
      "type": "List<String>",
      "description": "The hosts and addresses the clients may call; **every other one is denied**, private networks and loopback included. Each entry is a host name (`api.neon.books`), its subdomains (`*.neon.books`), an address literal (`203.0.113.7`), a CIDR block (`10.20.0.0/16`), or `*` for any host with a public address. The hosts of the `spring.http.serviceclient.<group>.base-url` values are on it by themselves. A name opens only public addresses: list the block of a private network (or `localhost`) too. Cloud metadata (`169.254.169.254`) needs its own entry. In a browser only the host of the URL is checked. Default: empty.",
      "default": [],
      "deprecated": null,
      "source": "package:spring_boot_starter_restclient/src/config/http_client_properties.dart",
      "line": 67,
      "class": "HttpClientsProperties"
    },
    {
      "name": "spring.http.clients.connect-timeout",
      "type": "Duration",
      "description": "The longest wait for a connection to open. Default: `10s` (`0`: none). The transport's own; a group's `connect-timeout` may be longer, the transport then waits as long as the longest of them.",
      "default": "10s",
      "deprecated": null,
      "source": "package:spring_boot_starter_restclient/src/config/http_client_properties.dart",
      "line": 46,
      "class": "HttpClientsProperties"
    },
    {
      "name": "spring.http.clients.read-timeout",
      "type": "Duration",
      "description": "The longest wait for data: for the response, then between two chunks of the body (not a limit of the whole call; the deadline of the enclosing request is that). Default: `60s` (`0`: none).",
      "default": "60s",
      "deprecated": null,
      "source": "package:spring_boot_starter_restclient/src/config/http_client_properties.dart",
      "line": 51,
      "class": "HttpClientsProperties"
    },

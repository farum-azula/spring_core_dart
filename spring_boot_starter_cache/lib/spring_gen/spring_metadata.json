    {
      "name": "spring.cache.type",
      "values": [
        {
          "value": "generic",
          "description": "Uses the application's `Cache` beans (a `SimpleCacheManager`)."
        },
        {
          "value": "simple",
          "description": "Keeps entries in memory (an `InMemoryCacheManager`)."
        },
        {
          "value": "none",
          "description": "Caches nothing, so the methods always run (a `NoOpCacheManager`)."
        },
        {
          "value": "disk",
          "description": "Keeps entries on disk, so they survive a restart (a `DiskCacheManager`): the app's `cache` place in Flutter, a folder elsewhere. Not Spring Boot's."
        }
      ]
    }

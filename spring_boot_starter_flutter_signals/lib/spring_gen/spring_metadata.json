  "hints": [
    {
      "name": "spring.flutter.signals.buffer.on-error",
      "values": [
        {
          "value": "discard",
          "description": "They are dropped."
        },
        {
          "value": "publish",
          "description": "They are told as if it had succeeded."
        }
      ]
    },
    {
      "name": "spring.flutter.signals.on-scope-end",
      "values": [
        {
          "value": "discard",
          "description": "They are dropped, and a warning names the bean and the fields."
        },
        {
          "value": "flush",
          "description": "They are told at once, before the bean ends."
        },
        {
          "value": "defer",
          "description": "The bean's state stays until they are told by its queue, or until `spring.flutter.signals.defer-timeout` passes (then a warning)."
        }
      ]
    },
    {
      "name": "spring.flutter.signals.queue.flush",
      "values": [
        {
          "value": "immediate",
          "description": "[SignalFlushSchedules.immediate]."
        },
        {
          "value": "microtask",
          "description": "[SignalFlushSchedules.microtask]."
        },
        {
          "value": "frame",
          "description": "[SignalFlushSchedules.frame]."
        },
        {
          "value": "interval",
          "description": "[SignalFlushSchedules.interval]."
        }
      ]
    },
    {
      "name": "spring.flutter.signals.queue.on-overflow",
      "values": [
        {
          "value": "flush",
          "description": "Tells what it holds now, and takes the write. While the queue is telling already (a reader that writes), it refuses the write as [dropNewest] does."
        },
        {
          "value": "drop-oldest",
          "description": "Drops the oldest write it holds (the field keeps its value from before that write), with a warning."
        },
        {
          "value": "drop-newest",
          "description": "Refuses this write (the field keeps its value), with a warning."
        }
      ]
    },
    {
      "name": "spring.flutter.signals.queues.*.flush",
      "values": [
        {
          "value": "immediate",
          "description": "[SignalFlushSchedules.immediate]."
        },
        {
          "value": "microtask",
          "description": "[SignalFlushSchedules.microtask]."
        },
        {
          "value": "frame",
          "description": "[SignalFlushSchedules.frame]."
        },
        {
          "value": "interval",
          "description": "[SignalFlushSchedules.interval]."
        }
      ]
    },
    {
      "name": "spring.flutter.signals.queues.*.on-overflow",
      "values": [
        {
          "value": "flush",
          "description": "Tells what it holds now, and takes the write. While the queue is telling already (a reader that writes), it refuses the write as [dropNewest] does."
        },
        {
          "value": "drop-oldest",
          "description": "Drops the oldest write it holds (the field keeps its value from before that write), with a warning."
        },
        {
          "value": "drop-newest",
          "description": "Refuses this write (the field keeps its value), with a warning."
        }
      ]
    },
    {
      "name": "spring.flutter.signals.transaction.mode",
      "values": [
        {
          "value": "buffered",
          "description": "Held in a [SignalBuffer] until the commit and dropped by a rollback."
        },
        {
          "value": "direct",
          "description": "Written at once, whatever the transaction does later."
        }
      ]
    }
  ],

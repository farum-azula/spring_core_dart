    {
      "name": "spring.json.default-property-inclusion",
      "values": [
        {
          "value": "always",
          "description": "Every value, `null` included (`ALWAYS`). The mapper's default."
        },
        {
          "value": "non-null",
          "description": "Every value except `null` (`NON_NULL`)."
        },
        {
          "value": "non-absent",
          "description": "Every value except `null` (`NON_ABSENT`); the same as [nonNull], as Dart has no `Optional`."
        },
        {
          "value": "non-empty",
          "description": "Every value except `null` and an empty string, list, set or map (`NON_EMPTY`)."
        },
        {
          "value": "non-default",
          "description": "Every value that differs from its default (`NON_DEFAULT`). On a class (`@JsonInclude(JsonInclusion.nonDefault)` on the class), the default is the value in an instance created with the no-argument constructor. Elsewhere, or when the class has no such constructor, it is the default of the type: `null`, `0`, `false` and what [nonEmpty] leaves out."
        }
      ]
    },
